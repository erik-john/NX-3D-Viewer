# Keep the Windows working tree in CRLF while Git stores normalized text.
* text=auto

*.py      text eol=crlf
*.html    text eol=crlf
*.css     text eol=crlf
*.js      text eol=crlf
*.mjs     text eol=crlf
*.md      text eol=crlf
*.txt     text eol=crlf
*.bat     text eol=crlf
*.json    text eol=crlf
*.toml    text eol=crlf
*.yml     text eol=crlf
*.yaml    text eol=crlf
*.xml     text eol=crlf
*.svg     text eol=crlf
*.ini     text eol=crlf
*.cfg     text eol=crlf
.gitignore    text eol=crlf
.gitattributes text eol=crlf

# Never apply line-ending conversion to binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.stl binary
*.prt binary
*.jt  binary
*.chr binary
*.zip binary
