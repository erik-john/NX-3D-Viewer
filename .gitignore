# Python caches and compiled files
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Python environments
.venv/
venv/
env/

# Local configuration and credentials
.env
.env.*
!.env.example
*.local

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Generated data, exports, and runtime files
logs/
*.log
*.pid
cache/
temp/
tmp/
exports/
output/
dist/
build/
uploads/

# Keep source files under tests/, dev/, and tools/ eligible for commits.
# Ignore only their generated reports and coverage artifacts.
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
